# 复制此文件为 .env 并填入真实值
# .env 文件已在 .gitignore 中，不会被提交

# DeepSeek API Key (https://platform.deepseek.com)
VITE_DEEPSEEK_API_KEY=sk-your-api-key-here

# 管理员后台登录密码（必填，建议使用强密码，至少8位含大小写字母+数字+特殊字符）
ADMIN_PASSWORD=your-strong-password-here

# 会话加密密钥（必填，任意随机字符串，用于 Session 加密）
# 设置后重启容器不会导致所有用户登出
# 生成方式: openssl rand -hex 32 或 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-random-session-secret-here
